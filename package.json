{
  "name": "wardenbroker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev:web": "vite",
    "dev": "vite build && wrangler dev",
    "deploy": "vite build && wrangler deploy",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p worker/tsconfig.json --noEmit",
    "icons": "node scripts/icons.mjs",
    "cli:build": "cd cli && go build -o ../dist-cli/wardenbroker ./cmd/wardenbroker",
    "test": "npm run test:unit && npm run test:go && npm run test:e2e",
    "test:unit": "node --test test/unit/*.test.mjs",
    "test:go": "cd cli && go vet ./... && go test ./...",
    "test:e2e": "node test/e2e/run.mjs"
  },
  "dependencies": {
    "hash-wasm": "^4.12.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "^0.28.2",
    "playwright": "1.63.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "wrangler": "^4.158.0"
  }
}
